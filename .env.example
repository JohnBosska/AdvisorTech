POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=techadviser
POSTGRES_USER=techadviser
POSTGRES_PASSWORD=change-me

POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=50
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800
POSTGRES_POOL_PRE_PING=true

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=techadviser-default

AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_ACCESS_TOKEN_TTL_SECONDS=1800
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# Refresh cookie is Secure by default. Set false only for plain-http local runs.
AUTH_COOKIE_SECURE=true
AUTH_INVITATION_TTL_SECONDS=604800
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=600
AUTH_EMAIL_VERIFICATION_MAX_ATTEMPTS=5
AUTH_EMAIL_VERIFICATION_RESEND_SECONDS=60
# AI analyst. Empty = chat answers 503 "not configured"; documents can still be uploaded.
# GigaChat (preferred): the base64 "Authorization key" from developers.sber.ru. Used for chat AND
# embeddings (pgvector semantic search), so no other key is needed.
AI_GIGACHAT_CREDENTIALS=
AI_GIGACHAT_SCOPE=GIGACHAT_API_PERS
AI_GIGACHAT_MODEL=GigaChat
# Alternative provider if GigaChat is not set:
# DeepSeek: primary LLM when set. Embeddings via DeepSeek only if AI_DEEPSEEK_EMBEDDING_MODEL is set
# and the account really serves /embeddings with AI_EMBEDDING_DIM (1024) vectors.
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_MODEL=deepseek-flash
AI_DEEPSEEK_EMBEDDING_MODEL=
# Voyage AI key: embeddings only, when GigaChat is not used.
AI_EMBEDDING_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLIENT_ID=
TELEGRAM_AUTH_DATA_MAX_AGE_SECONDS=300

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SENDER=
EMAIL_START_TLS=true
EMAIL_USE_TLS=false

# --- nginx-proxy-manager (docker compose) ---
# Domains must resolve to this server. APP_DOMAIN serves the web app and proxies /api;
# API_DOMAIN (optional) exposes the API directly, e.g. for Connector Agents.
APP_DOMAIN=
API_DOMAIN=
NPM_ADMIN_EMAIL=
NPM_ADMIN_PASSWORD=
# Set to request Let's Encrypt certificates (needs public DNS and ports 80/443). It also becomes the NPM admin login.
NPM_LETSENCRYPT_EMAIL=
# Admin UI (port 81) is bound to loopback; set 0.0.0.0 only behind a firewall.
NPM_ADMIN_BIND=127.0.0.1
